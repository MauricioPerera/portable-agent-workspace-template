{
  "schemaVersion": 1,
  "flowId": "clasificar-textos",
  "objective": "Clasificar textos por prioridad en urgente, normal y revisión; conservar el identificador; respetar negaciones explícitas de urgencia y marcar textos vacíos, incertidumbre o señales contradictorias para revisión; exponer las reglas aplicadas.",
  "maxLimits": { "timeoutMs": 3000, "memoryMb": 128, "outputBytes": 16384 },
  "maxMedianMs": 10000,
  "taskCases": {
    "normalizar": [
      { "id": "unicode-espacios", "input": { "texto": "  REVISIÓN\tY\nURGENCIA  " }, "expected": { "texto_normalizado": "revisión y urgencia" } },
      { "id": "unicode-descompuesto", "input": { "texto": "  REVISIÓN  " }, "expected": { "texto_normalizado": "revisión" } },
      { "id": "vacio", "input": { "texto": " \t\n " }, "expected": { "texto_normalizado": "" } },
      { "id": "rechaza-numero", "input": { "texto": 42 }, "expectError": true, "expectErrorCode": "SCHEMA_INVALID" }
    ],
    "clasificar": [
      { "id": "urgente-explicita", "input": { "texto_normalizado": "urgente: necesito ayuda" }, "expected": { "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.explicita"] } },
      { "id": "bloqueo", "input": { "texto_normalizado": "estoy bloqueado, no puedo trabajar" }, "expected": { "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.bloqueo"] } },
      { "id": "caida-con-acento", "input": { "texto_normalizado": "el servicio caído necesita atención" }, "expected": { "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.caida"] } },
      { "id": "no-puede-esperar", "input": { "texto_normalizado": "no puede esperar" }, "expected": { "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.inmediata"] } },
      { "id": "respuesta-femenina", "input": { "texto_normalizado": "se solicita atención inmediata" }, "expected": { "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.inmediata"] } },
      { "id": "negacion", "input": { "texto_normalizado": "no es urgente, puede esperar" }, "expected": { "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": ["normal.sin_urgencia", "normal.sin_prisa"] } },
      { "id": "no-hay-urgencia", "input": { "texto_normalizado": "no hay urgencia" }, "expected": { "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": ["normal.sin_urgencia"] } },
      { "id": "consulta-normal", "input": { "texto_normalizado": "consulta sobre el horario" }, "expected": { "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": [] } },
      { "id": "limite-palabra", "input": { "texto_normalizado": "adjunto un dibujo desbloqueado" }, "expected": { "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": [] } },
      { "id": "incertidumbre", "input": { "texto_normalizado": "no sé si es urgente" }, "expected": { "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["urgente.explicita", "revision.incertidumbre"] } },
      { "id": "pregunta", "input": { "texto_normalizado": "¿es urgente?" }, "expected": { "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["urgente.explicita", "revision.incertidumbre"] } },
      { "id": "contradiccion", "input": { "texto_normalizado": "no es urgente pero el servicio caído impide operar" }, "expected": { "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["urgente.caida", "normal.sin_urgencia", "revision.conflicto"] } },
      { "id": "vacio", "input": { "texto_normalizado": "" }, "expected": { "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["revision.vacio"] } },
      { "id": "rechaza-campo-extra", "input": { "texto_normalizado": "hola", "extra": true }, "expectError": true, "expectErrorCode": "SCHEMA_INVALID" }
    ]
  },
  "flowCases": [
    { "id": "conserva-id-urgente", "input": { "id": "ticket-ñ-01", "texto": "  URGENTE\tEstoy BLOQUEADO  " }, "expected": { "id": "ticket-ñ-01", "texto_normalizado": "urgente estoy bloqueado", "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.explicita", "urgente.bloqueo"] } },
    { "id": "normal-negacion", "input": { "id": "ticket-02", "texto": "  NO ES URGENTE, cuando puedas  " }, "expected": { "id": "ticket-02", "texto_normalizado": "no es urgente, cuando puedas", "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": ["normal.sin_urgencia", "normal.sin_prisa"] } },
    { "id": "normal-informativo", "input": { "id": "ticket-03", "texto": "  Consulta sobre el HORARIO  " }, "expected": { "id": "ticket-03", "texto_normalizado": "consulta sobre el horario", "categoria": "normal", "requiere_revision": false, "reglas_aplicadas": [] } },
    { "id": "revision-incertidumbre", "input": { "id": "ticket-04", "texto": "No SÉ si es URGENTE" }, "expected": { "id": "ticket-04", "texto_normalizado": "no sé si es urgente", "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["urgente.explicita", "revision.incertidumbre"] } },
    { "id": "revision-contradiccion", "input": { "id": "ticket-05", "texto": "Sin prisa, pero necesito respuesta INMEDIATAmente" }, "expected": { "id": "ticket-05", "texto_normalizado": "sin prisa, pero necesito respuesta inmediatamente", "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["urgente.inmediata", "normal.sin_prisa", "revision.conflicto"] } },
    { "id": "vacio-revision", "input": { "id": "ticket-06", "texto": " \t " }, "expected": { "id": "ticket-06", "texto_normalizado": "", "categoria": "revisión", "requiere_revision": true, "reglas_aplicadas": ["revision.vacio"] } },
    { "id": "urgente-servicio-caido", "input": { "id": "ticket-07", "texto": "  El SERVICIO CAÍDO afecta al equipo  " }, "expected": { "id": "ticket-07", "texto_normalizado": "el servicio caído afecta al equipo", "categoria": "urgente", "requiere_revision": false, "reglas_aplicadas": ["urgente.caida"] } },
    { "id": "rechaza-texto-no-string", "input": { "id": "ticket-08", "texto": 42 }, "expectError": true, "expectErrorCode": "SCHEMA_INVALID" },
    { "id": "rechaza-id-vacio", "input": { "id": "", "texto": "consulta" }, "expectError": true, "expectErrorCode": "SCHEMA_INVALID" },
    { "id": "rechaza-id-ausente", "input": { "texto": "consulta" }, "expectError": true, "expectErrorCode": "SCHEMA_INVALID" }
  ]
}
